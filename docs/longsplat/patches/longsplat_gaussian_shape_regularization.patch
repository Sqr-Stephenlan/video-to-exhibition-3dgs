diff --git a/utils/loss_utils.py b/utils/loss_utils.py
index e7fed8b..d897313 100755
--- a/utils/loss_utils.py
+++ b/utils/loss_utils.py
@@ -241,3 +241,18 @@ def normal_consistency_loss(
     return (1.0 - cos_sim).mean()
 
 
+def anisotropy_regularization(
+    scaling: torch.Tensor,
+    *,
+    soft_limit: float,
+) -> torch.Tensor:
+    """Penalise needle-like splats whose axis ratio exceeds *soft_limit*.
+
+    Returns a scalar loss; strictly 0 when every Gaussian's
+    ``max(scale) / min(scale) <= soft_limit``.
+    """
+    import math
+
+    safe = scaling.clamp_min(1e-8)
+    log_ratio = torch.log(safe.amax(dim=1)) - torch.log(safe.amin(dim=1))
+    return torch.relu(log_ratio - math.log(soft_limit)).square().mean()
