+def compute_texture_mask(image, threshold=0.05):
+    """Compute a per-pixel texture mask: low-texture regions get lower weight.
+    Returns a mask in [0, 1] where low-texture areas approach 0."""
+    if image.dim() == 3:
+        gray = image.mean(dim=0, keepdim=True)
+    else:
+        gray = image
+
+    grad_x = torch.abs(gray[:, :-1] - gray[:, 1:])
+    grad_y = torch.abs(gray[:-1, :] - gray[1:, :])
+
+    grad_mag = torch.zeros_like(gray)
+    grad_mag[:, :-1] += grad_x
+    grad_mag[:, 1:] += grad_x
+    grad_mag[:-1, :] += grad_y
+    grad_mag[1:, :] += grad_y
+
+    mask = (grad_mag > threshold).float()
+    return mask.squeeze(0)
