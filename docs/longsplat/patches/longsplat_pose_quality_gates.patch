diff --git a/utils/pose_utils.py b/utils/pose_utils.py
index acec092..9099251 100644
--- a/utils/pose_utils.py
+++ b/utils/pose_utils.py
@@ -19,6 +19,48 @@ from utils.loss_utils import l1_loss, ssim, depth_loss
 from utils.graphics_utils import warping, get_occlusion_mask, unporject
 from gaussian_renderer import render
 
+def project_to_so3(rotation):
+    """Project a 3×3 matrix to the closest SO(3) element via SVD.
+
+    Returns a matrix R' such that R' ∈ SO(3), i.e. det(R') = 1 and
+    R' @ R'.T = I.  The input may be a torch.Tensor or numpy array.
+    """
+    if isinstance(rotation, np.ndarray):
+        rotation = torch.from_numpy(rotation).float()
+    u, _, vh = torch.linalg.svd(rotation)
+    correction = torch.eye(3, device=rotation.device, dtype=rotation.dtype)
+    correction[-1, -1] = torch.sign(torch.det(u @ vh))
+    return u @ correction @ vh
+
+
+def keypoint_grid_coverage(points_px, width, height, grid_size=4):
+    """Fraction of grid cells that contain at least one keypoint."""
+    import numpy as np
+
+    if len(points_px) == 0:
+        return 0.0
+    cell_w = width / grid_size
+    cell_h = height / grid_size
+    cols = np.clip((points_px[:, 0] / cell_w).astype(int), 0, grid_size - 1)
+    rows = np.clip((points_px[:, 1] / cell_h).astype(int), 0, grid_size - 1)
+    occupied = set(zip(rows, cols))
+    return len(occupied) / (grid_size * grid_size)
+
+
+def rotation_step_deg(previous_r, candidate_r):
+    """Angular distance in degrees between two 3×3 rotation matrices."""
+    import math
+
+    if isinstance(previous_r, torch.Tensor):
+        previous_r = previous_r.detach().cpu().numpy()
+    if isinstance(candidate_r, torch.Tensor):
+        candidate_r = candidate_r.detach().cpu().numpy()
+    R_rel = candidate_r @ previous_r.T
+    trace_val = np.trace(R_rel)
+    cos_angle = np.clip((trace_val - 1.0) / 2.0, -1.0, 1.0)
+    return math.degrees(math.acos(cos_angle))
+
+
 def save_transforms(cameras, path):
     json_cams = []
     viewpoint_stack = cameras
