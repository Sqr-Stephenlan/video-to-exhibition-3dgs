+    def grad_consistency(d_gt, d_pred):
+        diff_x_gt = d_gt[..., :-1] - d_gt[..., 1:]
+        diff_y_gt = d_gt[..., :-1, :] - d_gt[..., 1:, :]
+        diff_x_pred = d_pred[..., :-1] - d_pred[..., 1:]
+        diff_y_pred = d_pred[..., :-1, :] - d_pred[..., 1:, :]
+        return F.l1_loss(diff_x_pred, diff_x_gt) + F.l1_loss(diff_y_pred, diff_y_gt)
