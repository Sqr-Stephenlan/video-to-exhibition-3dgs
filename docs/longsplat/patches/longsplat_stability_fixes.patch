+def ssi_loss(depth_gt, depth_pred, weight=None):
+    assert depth_gt.shape == depth_pred.shape
+    mask = (depth_gt > 0) & (depth_pred > 0)
+    if weight is not None:
+        mask = mask & (weight > 0)
+
+    log_diff = torch.log(depth_gt[mask] + 1e-8) - torch.log(depth_pred[mask] + 1e-8)
+    return (log_diff ** 2).mean() - 0.5 * (log_diff.mean() ** 2)
