+def align_vda_depth_with_stats(
+    v,
+    D_ref,
+    corr_threshold=0.3,
+    outlier_sigma=2.5,
+    min_inlier_ratio=0.0,
+    max_normalized_rmse=None,
+):
+    """Align VDA relative depth (disparity-like, higher=near) to scene z-depth.
+
+    Fits ``a·v + b ≈ 1/D_ref`` in inverse-depth space via least squares,
+    applies one round of ``outlier_sigma`` rejection, then produces an
+    aligned z-depth ``D_vda = 1 / clamp(a·v + b, eps)``.
+
+    Args:
+        v: VDA disparity tensor (H, W), raw values from NPZ.
+        D_ref: Reference scene-scale z-depth tensor (H, W), higher=far.
+        corr_threshold: Minimum Pearson |ρ| between 1/D_vda and 1/D_ref;
+            if the fit is weaker the function returns None (caller falls back).
+        outlier_sigma: Residual threshold (in σ) for re-fit rejection.
+        min_inlier_ratio: Minimum inlier fraction; if below, return None.
+        max_normalized_rmse: Maximum residual RMSE / median(|1/D_ref|);
+            if exceeded, return None.  ``None`` disables the check.
+
+    Returns:
+        A pair ``(depth, stats)``. ``depth`` is aligned z-depth with the same
+        dtype/device as D_ref, or ``None`` when a safety check rejects it.
+        ``stats`` contains only JSON-serializable diagnostic values.
+    """
+    eps = 1e-6
+    inv_ref = 1.0 / (D_ref + eps)
+
+    # Mask: both v and D_ref must be finite and positive
+    mask = torch.isfinite(v) & torch.isfinite(D_ref) & (D_ref > eps) & (v > eps)
+    v_flat = v[mask].reshape(-1, 1).float()
+    inv_flat = inv_ref[mask].reshape(-1, 1).float()
+    inlier_indices = torch.nonzero(mask.reshape(-1), as_tuple=True)[0]
+
+    valid_count = int(v_flat.numel())
+    stats = {
+        "result": "rejected",
+        "reason": None,
+        "valid_count": valid_count,
+        "inlier_count": 0,
+        "inlier_ratio": 0.0,
+        "slope": None,
+        "offset": None,
+        "correlation": None,
+        "residual_rmse": None,
+        "normalized_rmse": None,
+    }
+
+    if v_flat.numel() < 100:
+        stats["reason"] = "insufficient_valid_points"
+        return None, stats
+
+    # --- first fit ---
+    A = torch.cat([v_flat, torch.ones_like(v_flat)], dim=1)  # [N, 2]
+    sol, *_ = torch.linalg.lstsq(A, inv_flat)
+    a, b = sol[0, 0], sol[1, 0]
+
+    # --- outlier rejection ---
+    residual = torch.abs(A @ sol - inv_flat).squeeze()
+    threshold = float(residual.std()) * outlier_sigma + float(residual.mean())
+    keep = residual <= threshold
+
+    # --- re-fit on inliers ---
+    used_indices = inlier_indices  # for correlation check
+    if keep.sum() >= 100:
+        A2, inv2 = A[keep], inv_flat[keep]
+        sol2, *_ = torch.linalg.lstsq(A2, inv2)
+        a, b = float(sol2[0, 0]), float(sol2[1, 0])
+        used_indices = inlier_indices[keep]
+
+    a, b = float(a), float(b)
+    stats["slope"] = a if math.isfinite(a) else None
+    stats["offset"] = b if math.isfinite(b) else None
+    stats["inlier_count"] = int(used_indices.numel())
+    stats["inlier_ratio"] = (
+        stats["inlier_count"] / valid_count if valid_count else 0.0
+    )
+
+    if not math.isfinite(a) or not math.isfinite(b):
+        stats["reason"] = "nonfinite_fit"
+        return None, stats
+
+    # --- slope safety valve: negative a means VDA and reference point in
+    #     opposite directions (higher v → lower 1/D), which violates the
+    #     disparity → z-depth model ---
+    if a <= 0:
+        print(f"[align_vda_depth] WARNING: negative slope a={a:.4f}, falling back")
+        stats["reason"] = "nonpositive_slope"
+        return None, stats
+
+    # --- correlation safety valve ---
+    if used_indices.numel() < 100:
+        stats["reason"] = "insufficient_inliers"
+        return None, stats
+    inv_vda_flat2 = (a * v.reshape(-1).float()[used_indices] + b)
+    inv_ref_flat2 = inv_ref.reshape(-1).float()[used_indices]
+    stacked = torch.stack([inv_vda_flat2, inv_ref_flat2], dim=0)
+    corr = torch.corrcoef(stacked)[0, 1]
+
+    corr_value = float(corr)
+    stats["correlation"] = corr_value if math.isfinite(corr_value) else None
+    residual_rmse = float(
+        torch.sqrt(torch.mean((inv_vda_flat2 - inv_ref_flat2) ** 2))
+    )
+    stats["residual_rmse"] = (
+        residual_rmse if math.isfinite(residual_rmse) else None
+    )
+
+    # --- normalized RMSE: residual / median(|1/D_ref|) ---
+    median_abs_inv_ref = float(torch.median(torch.abs(inv_ref_flat2)).item())
+    nrmse = residual_rmse / (median_abs_inv_ref + 1e-8)
+    stats["normalized_rmse"] = nrmse if math.isfinite(nrmse) else None
+
+    # --- quality gate: stricter checks beyond basic corr_threshold ---
+    if not math.isfinite(corr_value) or corr_value < corr_threshold:
+        print(f"[align_vda_depth] WARNING: low correlation ρ={float(corr):.4f}, falling back")
+        stats["reason"] = "low_correlation"
+        return None, stats
+
+    if stats["inlier_ratio"] < min_inlier_ratio:
+        print(f"[align_vda_depth] WARNING: low inlier ratio {stats['inlier_ratio']:.4f} < {min_inlier_ratio}, falling back")
+        stats["reason"] = "low_inlier_ratio"
+        return None, stats
+
+    if (max_normalized_rmse is not None
+            and stats["normalized_rmse"] is not None
+            and stats["normalized_rmse"] > max_normalized_rmse):
+        print(f"[align_vda_depth] WARNING: high normalized RMSE {stats['normalized_rmse']:.4f} > {max_normalized_rmse}, falling back")
+        stats["reason"] = "high_normalized_rmse"
+        return None, stats
+
+    # --- produce output, filling invalid pixels with reference depth ---
+    D_vda = 1.0 / torch.clamp(a * v + b, min=eps)
+    # Sanitise: non-finite outputs replaced by reference
+    bad = ~torch.isfinite(D_vda)
+    D_vda[bad] = D_ref[bad]
+    stats["result"] = "aligned"
+    stats["reason"] = None
+    return D_vda.to(device=D_ref.device, dtype=D_ref.dtype), stats
+
+
+def align_vda_depth(v, D_ref, corr_threshold=0.3, outlier_sigma=2.5):
+    """Backward-compatible alignment API returning only the depth tensor."""
+    depth, _ = align_vda_depth_with_stats(
+        v,
+        D_ref,
+        corr_threshold=corr_threshold,
+        outlier_sigma=outlier_sigma,
+    )
+    return depth
+
