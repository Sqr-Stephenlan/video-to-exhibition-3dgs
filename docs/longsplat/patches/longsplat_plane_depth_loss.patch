+def make_depth_quality_mask(
+    reference_depth: torch.Tensor,
+    rgb: torch.Tensor,
+    *,
+    depth_edge_quantile: float = 0.90,
+    rgb_edge_quantile: float = 0.95,
+    erosion_radius: int = 2,
+) -> torch.Tensor:
+    """Exclude depth/RGB edges from a valid-depth base mask.
+
+    Returns a (H, W) boolean mask where:
+    - depth is positive and finite,
+    - depth gradient magnitude is below the ``depth_edge_quantile`` quantile,
+    - RGB gradient magnitude is below the ``rgb_edge_quantile`` quantile,
+    - and ``erosion_radius`` px of morphological erosion have been applied.
+    """
+    H, W = reference_depth.shape
+    device = reference_depth.device
+
+    valid = (reference_depth > 0) & torch.isfinite(reference_depth)
+    if valid.sum() == 0:
+        return torch.zeros(H, W, dtype=torch.bool, device=device)
+
+    # Depth gradient magnitude (forward differences + padding)
+    dx_d = torch.zeros(H, W, dtype=reference_depth.dtype, device=device)
+    dy_d = torch.zeros(H, W, dtype=reference_depth.dtype, device=device)
+    dx_d[:, :-1] = (reference_depth[:, 1:] - reference_depth[:, :-1]).abs()
+    dy_d[:-1, :] = (reference_depth[1:, :] - reference_depth[:-1, :]).abs()
+    depth_edge = dx_d + dy_d
+
+    # RGB gradient magnitude (luminance proxy)
+    rgb_gray = rgb.mean(dim=0)
+    dx_r = torch.zeros(H, W, dtype=rgb.dtype, device=device)
+    dy_r = torch.zeros(H, W, dtype=rgb.dtype, device=device)
+    dx_r[:, :-1] = (rgb_gray[:, 1:] - rgb_gray[:, :-1]).abs()
+    dy_r[:-1, :] = (rgb_gray[1:, :] - rgb_gray[:-1, :]).abs()
+    rgb_edge = dx_r + dy_r
+
+    depth_thresh = torch.quantile(depth_edge[valid], depth_edge_quantile)
+    rgb_thresh = torch.quantile(rgb_edge[valid], rgb_edge_quantile)
+
+    mask = valid & (depth_edge <= depth_thresh) & (rgb_edge <= rgb_thresh)
+
+    # Morphological erosion (4-connected)
+    for _ in range(erosion_radius):
+        eroded = mask.clone()
+        eroded[:-1, :] &= mask[1:, :]
+        eroded[1:, :] &= mask[:-1, :]
+        eroded[:, :-1] &= mask[:, 1:]
+        eroded[:, 1:] &= mask[:, :-1]
+        mask = eroded
+
+    return mask
+
+
+def _compute_normals_from_depth(
+    depth: torch.Tensor,
+    intrinsic: torch.Tensor,
+) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor]:
+    """Return (nx, ny, nz) normal components for interior pixels (H-2, W-2)."""
+    H, W = depth.shape
+    fx = intrinsic[0, 0]
+    fy = intrinsic[1, 1]
+    cx = intrinsic[0, 2]
+    cy = intrinsic[1, 2]
+
+    v, u = torch.meshgrid(
+        torch.arange(H, device=depth.device, dtype=depth.dtype),
+        torch.arange(W, device=depth.device, dtype=depth.dtype),
+        indexing="ij",
+    )
+
+    x = (u - cx) / fx * depth
+    y = (v - cy) / fy * depth
+
+    # Pad tensors for central differences
+    x_pad = F.pad(x.unsqueeze(0).unsqueeze(0), (1, 1, 1, 1), mode="replicate")[0, 0]
+    y_pad = F.pad(y.unsqueeze(0).unsqueeze(0), (1, 1, 1, 1), mode="replicate")[0, 0]
+    z_pad = F.pad(depth.unsqueeze(0).unsqueeze(0), (1, 1, 1, 1), mode="replicate")[0, 0]
+
+    # Central differences on interior (H, W) region
+    dx_du = (x_pad[1:-1, 2:] - x_pad[1:-1, :-2]) / 2.0
+    dy_du = (y_pad[1:-1, 2:] - y_pad[1:-1, :-2]) / 2.0
+    dz_du = (z_pad[1:-1, 2:] - z_pad[1:-1, :-2]) / 2.0
+
+    dx_dv = (x_pad[2:, 1:-1] - x_pad[:-2, 1:-1]) / 2.0
+    dy_dv = (y_pad[2:, 1:-1] - y_pad[:-2, 1:-1]) / 2.0
+    dz_dv = (z_pad[2:, 1:-1] - z_pad[:-2, 1:-1]) / 2.0
+
+    # Cross product
+    nx = dy_du * dz_dv - dz_du * dy_dv
+    ny = dz_du * dx_dv - dx_du * dz_dv
+    nz = dx_du * dy_dv - dy_du * dx_dv
+
+    norm = torch.sqrt(nx * nx + ny * ny + nz * nz).clamp_min(1e-8)
+    return nx / norm, ny / norm, nz / norm
+
+
+def normal_consistency_loss(
+    predicted_depth: torch.Tensor,
+    reference_depth: torch.Tensor,
+    intrinsic: torch.Tensor,
+    mask: torch.Tensor,
+) -> torch.Tensor:
+    """1 - cosine-similarity between surface normals inside *mask*.
+
+    Returns a scalar; strictly 0 when fewer than 1,000 pixels are valid.
+    """
+    # Interior of the depth quality mask (exclude border where gradients are
+    # unavailable)
+    interior = mask[1:-1, 1:-1]
+    if interior.sum() < 1000:
+        return torch.tensor(0.0, device=predicted_depth.device, dtype=predicted_depth.dtype)
+
+    nx_pred, ny_pred, nz_pred = _compute_normals_from_depth(predicted_depth, intrinsic)
+    nx_ref, ny_ref, nz_ref = _compute_normals_from_depth(reference_depth, intrinsic)
+
+    # Select masked interior pixels
+    nx_pred = nx_pred[interior]
+    ny_pred = ny_pred[interior]
+    nz_pred = nz_pred[interior]
+    nx_ref = nx_ref[interior]
+    ny_ref = ny_ref[interior]
+    nz_ref = nz_ref[interior]
+
+    cos_sim = (
+        nx_pred * nx_ref + ny_pred * ny_ref + nz_pred * nz_ref
+    ).clamp(-1.0, 1.0)
+    return (1.0 - cos_sim).mean()
+
+
